@inject EstadoSesion Estado
@implements IDisposable

@*
   ============================================================
   EL MENÚ, ARMADO CON LOS PERMISOS DE QUIEN ESTÁ IDENTIFICADO.

   Y AQUÍ VA LA ADVERTENCIA MÁS IMPORTANTE DE LA v3:

       ESCONDER UNA ENTRADA DEL MENÚ NO ES CONTROL DE ACCESO.

   Es la trampa en la que cae casi todo el mundo, porque PARECE que funciona:
   el vendedor entra, no ve «Usuarios», y se va tranquilo.

   Pero este menú es HTML que ya está en su navegador. Quien escriba la
   dirección a mano llega igual a la interfaz. Lo que lo para es que la API
   responda 403, y eso lo hace [ExigePermiso], no este archivo.

   ENTONCES PARA QUÉ SIRVE: para no mostrarle a alguien lo que no va a poder
   usar. Es comodidad. La protección está en el servicio.

   SE COMPRUEBA ASÍ (criterio 9): identifíquese como `vendedor1` —que no tiene
   `interfaz.usuarios`— y escriba `/usuarios` en la barra de direcciones. La
   interfaz se abre y tiene que mostrar el 403 que respondió la API.
   ============================================================
*@
<nav class="navbar navbar-expand-lg bg-body-tertiary border-bottom sticky-top">
    <div class="container">
        <a class="navbar-brand fw-semibold" href="/">
            <span class="text-primary">Facturas</span>
        </a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                data-bs-target="#menuPrincipal" aria-controls="menuPrincipal"
                aria-expanded="false" aria-label="Abrir el menú">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="menuPrincipal">
            @if (!Estado.Identificado)
            {
                @* Sin sesión el menú tiene UNA entrada. No se esconde el resto
                   por seguridad —ya se dijo que eso no protege— sino porque no
                   hay nada que mostrar: todas responderían 401. *@
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <NavLink class="nav-link" href="sesion">Iniciar sesión</NavLink>
                    </li>
                </ul>
            }
            else
            {
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <NavLink class="nav-link" href="" Match="NavLinkMatch.All">Inicio</NavLink>
                    </li>
                        @if (Estado.PuedeVer("interfaz.productos"))
                        {
                            <li class="nav-item">
                                <NavLink class="nav-link" href="productos">Productos</NavLink>
                            </li>
                        }
                        @if (Estado.PuedeVer("interfaz.empresas"))
                        {
                            <li class="nav-item">
                                <NavLink class="nav-link" href="empresas">Empresas</NavLink>
                            </li>
                        }
                        @if (Estado.PuedeVer("interfaz.personas"))
                        {
                            <li class="nav-item">
                                <NavLink class="nav-link" href="personas">Personas</NavLink>
                            </li>
                        }
                        @if (Estado.PuedeVer("interfaz.roles"))
                        {
                            <li class="nav-item">
                                <NavLink class="nav-link" href="roles">Roles</NavLink>
                            </li>
                        }
                        @if (Estado.PuedeVer("interfaz.rutas"))
                        {
                            <li class="nav-item">
                                <NavLink class="nav-link" href="rutas">Rutas</NavLink>
                            </li>
                        }
                        @if (Estado.PuedeVer("interfaz.usuarios"))
                        {
                            <li class="nav-item">
                                <NavLink class="nav-link" href="usuarios">Usuarios</NavLink>
                            </li>
                        }
                        @if (Estado.PuedeVer("interfaz.clientes"))
                        {
                            <li class="nav-item">
                                <NavLink class="nav-link" href="clientes">Clientes</NavLink>
                            </li>
                        }
                        @if (Estado.PuedeVer("interfaz.vendedores"))
                        {
                            <li class="nav-item">
                                <NavLink class="nav-link" href="vendedores">Vendedores</NavLink>
                            </li>
                        }
                        @if (Estado.PuedeVer("interfaz.facturas"))
                        {
                            <li class="nav-item">
                                <NavLink class="nav-link" href="facturas">Facturas</NavLink>
                            </li>
                        }
                        @if (Estado.PuedeVer("interfaz.usuarios"))
                        {
                            <li class="nav-item">
                                <NavLink class="nav-link" href="usuario-con-roles">Usuarios y roles</NavLink>
                            </li>
                        }
                        @if (Estado.PuedeVer("interfaz.usuarios"))
                        {
                            <li class="nav-item">
                                <NavLink class="nav-link" href="rol-usuario">Roles por usuario</NavLink>
                            </li>
                        }
                        @if (Estado.PuedeVer("interfaz.permisos"))
                        {
                            <li class="nav-item">
                                <NavLink class="nav-link" href="ruta-rol">Permisos por rol</NavLink>
                            </li>
                        }
                </ul>
            }
        </div>
    </div>
</nav>

@code {
    // El menú se vuelve a dibujar cuando alguien entra o sale, sin que nadie
    // recargue la página.
    protected override void OnInitialized() => Estado.Cambio += Redibujar;

    private void Redibujar() => InvokeAsync(StateHasChanged);

    public void Dispose() => Estado.Cambio -= Redibujar;
}
