@inject EstadoSesion Estado
@implements IDisposable

@*
   ============================================================
   EL MENU, ARMADO CON LOS PERMISOS DE QUIEN ESTA IDENTIFICADO.

   Y AQUI VA LA ADVERTENCIA MAS IMPORTANTE DE LA v3:

       ESCONDER UNA ENTRADA DEL MENU NO ES CONTROL DE ACCESO.

   Es la trampa en la que cae casi todo el mundo, porque PARECE que funciona:
   el vendedor entra, no ve «Usuarios», y se va tranquilo.

   Pero este menu es HTML que ya esta en su navegador. Quien escriba la
   direccion a mano -o abra las herramientas del navegador- llega igual a la
   interfaz. Lo que lo para es que la API responda 403, y eso lo hace
   [ExigePermiso], no este archivo.

   ENTONCES PARA QUE SIRVE ESTO: para no mostrarle a alguien lo que no va a
   poder usar. Es comodidad. La proteccion esta en el servicio.

   SE COMPRUEBA ASI (criterio 9): identifiquese como vendedor1 —que no tiene
   `interfaz.usuarios`— y escriba /usuarios en la barra de direcciones. La
   interfaz se abre, y tiene que mostrar el 403 que respondio la API. Si
   mostrara los datos, el control estaba en el menu — y no era control de
   acceso: era decoracion.

   Las entradas van agrupadas POR VERSION, que es la forma mas rapida de ver
   que cada version INCLUYE la anterior.
   ============================================================
*@
<nav class="menu">
    <span class="marca">Facturas</span>

    @if (!Estado.Identificado)
    {
        @* Sin sesion, el menu tiene UNA entrada. No se esconde el resto por
           seguridad —ya se dijo que eso no protege— sino porque no hay nada
           que mostrar: todas las demas responderian 401. *@
        <NavLink href="sesion">Iniciar sesion</NavLink>
    }
    else
    {
        <NavLink href="" Match="NavLinkMatch.All">Inicio</NavLink>

        @* --- la v1 --- *@
        @if (Estado.PuedeVer("interfaz.productos")) { <NavLink href="productos">Productos</NavLink> }
        @if (Estado.PuedeVer("interfaz.empresas")) { <NavLink href="empresas">Empresas</NavLink> }
        @if (Estado.PuedeVer("interfaz.personas")) { <NavLink href="personas">Personas</NavLink> }
        @if (Estado.PuedeVer("interfaz.roles")) { <NavLink href="roles">Roles</NavLink> }
        @if (Estado.PuedeVer("interfaz.rutas")) { <NavLink href="rutas">Rutas</NavLink> }
        @if (Estado.PuedeVer("interfaz.usuarios")) { <NavLink href="usuarios">Usuarios</NavLink> }

        @* --- la v2 --- *@
        @if (Estado.PuedeVer("interfaz.clientes")) { <NavLink href="clientes">Clientes</NavLink> }
        @if (Estado.PuedeVer("interfaz.vendedores")) { <NavLink href="vendedores">Vendedores</NavLink> }
        @if (Estado.PuedeVer("interfaz.facturas")) { <NavLink href="facturas">Facturas</NavLink> }
        @if (Estado.PuedeVer("interfaz.usuarios")) { <NavLink href="usuario-con-roles">Usuarios y roles</NavLink> }
        @if (Estado.PuedeVer("interfaz.usuarios")) { <NavLink href="rol-usuario">Roles por usuario</NavLink> }
        @if (Estado.PuedeVer("interfaz.permisos")) { <NavLink href="ruta-rol">Permisos por rol</NavLink> }
    }
</nav>

@code {
    // El menu se vuelve a dibujar cuando alguien entra o sale, sin que nadie
    // recargue la pagina.
    protected override void OnInitialized() => Estado.Cambio += Redibujar;

    private void Redibujar() => InvokeAsync(StateHasChanged);

    public void Dispose() => Estado.Cambio -= Redibujar;
}
